# ---- Django ----
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# 生产环境填写站点完整来源，如 https://pawstay.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_HSTS_SECONDS=0
# 站点尚未配置 HTTPS 时设为 false（否则所有请求会被跳转到 https）
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_LOG_LEVEL=INFO
# 500 错误告警邮件收件人（逗号分隔），需同时配置下方邮件服务
DJANGO_ADMINS=

# ---- MySQL ----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=petowner
MYSQL_TEST_DATABASE=test_petowner

# ---- 邮件（找回密码、系统告警）；留空则打印到控制台 ----
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_SSL=true
DEFAULT_FROM_EMAIL=

# ---- 短信验证码（注册、找回密码）----
# console：验证码只打印到日志（开发用）；aliyun：阿里云短信服务，模板变量为 ${code}
SMS_BACKEND=console
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=

# ---- 品牌与门店 ----
SITE_NAME=PawStay 宠物寄养
SITE_SLOGAN=像家一样安心的宠物寄养
SITE_PHONE=400-800-1234
SITE_ADDRESS=上海市徐汇区宠爱路 88 号
SITE_HOURS=每天 08:00 - 21:00
SITE_ICP=

# ---- 业务规则 ----
LONG_STAY_DAYS=7
LONG_STAY_RATE=0.9
MAX_BOARDING_DAYS=60
REQUIRE_VACCINE=true
# true：本站模拟扫码收银台（开发默认）；false：走微信 Native / 支付宝电脑网站支付，需填写下方密钥
PAYMENT_SANDBOX=true
# 线上订单超过该分钟数未支付将自动取消并释放房间（需定时执行 manage.py expire_orders）
PAYMENT_TIMEOUT_MINUTES=30
# 微信支付 Native（V2 统一下单）
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_API_KEY=
# 微信退款 API 证书（apiclient_cert.pem）与私钥（apiclient_key.pem）；未配置时退款记门店账本
WECHAT_CERT_PATH=
WECHAT_KEY_PATH=
# 支付宝电脑网站支付（RSA2，私钥/公钥可为 PEM 全文，换行写成 \n）
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
# 业务短信触达事件：care,health（逗号分隔，留空则只发站内通知）
SMS_NOTIFY_EVENTS=
# 业务短信模板 CODE，模板变量为 ${content}；留空则复用 SMS_TEMPLATE_CODE
SMS_NOTIFY_TEMPLATE_CODE=
# 入住当天及之后取消，扣除前 N 晚房费作为违约金；0 表示随时免费取消
LATE_CANCEL_NIGHTS=1
# 提前离店时按实际入住晚数重新计价，并原路退还多付房费
EARLY_CHECKOUT_REFUND=true
