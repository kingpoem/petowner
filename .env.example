# ---- Django ----
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# 生产环境填写站点完整来源，如 https://pawstay.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_HSTS_SECONDS=0
# 站点尚未配置 HTTPS 时设为 false（否则所有请求会被跳转到 https）
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_LOG_LEVEL=INFO
# 500 错误告警邮件收件人（逗号分隔），需同时配置下方邮件服务
DJANGO_ADMINS=

# ---- MySQL ----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=petowner
MYSQL_TEST_DATABASE=test_petowner

# ---- 邮件（找回密码、系统告警）；留空则打印到控制台 ----
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_SSL=true
DEFAULT_FROM_EMAIL=

# ---- 短信（可选；课程版注册为手机号+密码，可不配）----
SMS_BACKEND=console
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=

# ---- 品牌与门店 ----
SITE_NAME=PawStay 宠物寄养
SITE_SLOGAN=像家一样安心的宠物寄养
SITE_PHONE=400-800-1234
SITE_ADDRESS=上海市徐汇区宠爱路 88 号
SITE_HOURS=每天 08:00 - 21:00
SITE_ICP=

# ---- 业务规则 ----
MAX_BOARDING_DAYS=60
REQUIRE_VACCINE=true
